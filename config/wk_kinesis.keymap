#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <100>;
            require-prior-idle-ms = <130>;
        };

        hm_lt: homerow_mods_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LT";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "balanced";
            quick-tap-ms = <100>;
            require-prior-idle-ms = <130>;
            bindings = <&mo>, <&kp>;
        };

        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "BSPC_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        bspc_del_lt: backspace_delelte_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "BSPC_DEL_LT";
            bindings = <&mo>, <&bspc_del>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <175>;
        };

        pbrc_left: ParenthesisOrBraceLeft {
            compatible = "zmk,behavior-mod-morph";
            label = "PARENBRACELEFT";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LEFT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        pbrc_right: ParenthesisOrBraceRight {
            compatible = "zmk,behavior-mod-morph";
            label = "PARENBRACERight";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hm_lt_arrow: hm_lt_arrow {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_LT_ARROW";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "balanced";
            quick-tap-ms = <100>;
            require-prior-idle-ms = <130>;
            bindings = <&mo>, <&none>;
        };

        hm_lt_bspc_del: hm_lt_bspc_del {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_LT_BSPC_DEL";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "balanced";
            quick-tap-ms = <120>;
            require-prior-idle-ms = <200>;
            bindings = <&mo>, <&bspc_del>;
        };

        long_hold: long_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LONG_HOLD";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <200>;
            require-prior-idle-ms = <200>;
        };

        hm_arrow: hm_arrow {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_ARROW";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "balanced";
            quick-tap-ms = <100>;
            require-prior-idle-ms = <130>;
            bindings = <&kp>, <&arrow>;
        };

        td_layer_switch: td_layer_switch {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LAYER_SWITCH";
            #binding-cells = <0>;
            bindings = <&sl 10>, <&to 0>;
        };

        hm_lt_ctrl: hm_lt_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_LT_CTRL";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "balanced";
            quick-tap-ms = <100>;
            require-prior-idle-ms = <130>;
            bindings = <&mo_ctrl>, <&kp>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "ARROW";
        };

        two_kp: param_arrow {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_2to1 &kp MACRO_PLACEHOLDER>;
            label = "PARAM_ARROW";
        };

        mo_ctrl: ctrl_mo {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &kp LCTRL>;

            label = "CTRL_MO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&to 10                   &kp N1                 &kp N2             &kp N3            &kp N4              &kp N5                                                                                                    &kp N6      &kp N7               &kp N8           &kp N9             &kp N0              &kp BACKSPACE
&kp TAB                  &hm_lt_ctrl 4 Q        &kp W              &kp E             &kp R               &kp T                                                                                                     &kp Y       &kp U                &kp I            &kp O              &kp P               &sl 10
&mt LEFT_CONTROL ESCAPE  &hm LEFT_WIN A         &hm LEFT_SHIFT S   &hm LEFT_ALT D    &hm LEFT_CONTROL F  &kp G                   &none                  &none      &trans  &trans                                  &hm_lt 3 H  &hm RIGHT_CONTROL J  &hm RIGHT_ALT K  &hm RIGHT_SHIFT L  &hm RIGHT_GUI SEMI  &kp SINGLE_QUOTE
&kp LEFT_SHIFT           &hm LEFT_CONTROL Z     &hm LEFT_ALT X     &hm LEFT_SHIFT C  &hm LEFT_GUI V      &kp B                                          &none      &trans                                          &kp N       &kp M                &kp COMMA        &kp DOT            &kp FSLH            &kp BACKSLASH
                         &hm_lt 8 LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LBRC          &hm LEFT_ALT RBRC           &hm_lt 1 SPACE  &hm_lt 2 LEFT_CONTROL  &none      &trans  &hm_lt 2 RIGHT_CONTROL  &hm_lt 1 ENTER              &hm RIGHT_ALT MINUS  &kp EQUAL        &kp GRAVE          &hm_lt 8 BACKSLASH
            >;
        };

        layer_1 {
            bindings = <
&to 0                       &trans                    &trans                  &trans             &trans                   &trans                                                                                 &trans     &trans                       &trans                  &trans                            &trans                           &trans
&trans                      &kp LEFT_BRACE            &kp RIGHT_BRACE         &kp PLUS           &kp MINUS                &kp GRAVE                                                                              &kp TILDE  &kp UNDERSCORE               &kp EQUAL               &kp LEFT_BRACKET                  &kp RIGHT_BRACKET                &trans
&two_kp MINUS GREATER_THAN  &hm LEFT_GUI EXCLAMATION  &hm LEFT_SHIFT AT_SIGN  &hm LEFT_ALT HASH  &hm LEFT_CONTROL DOLLAR  &kp PERCENT                         &trans  &trans      &trans  &trans                 &kp CARET  &hm RIGHT_CONTROL AMPERSAND  &hm RIGHT_ALT ASTERISK  &hm RIGHT_SHIFT LEFT_PARENTHESIS  &hm RIGHT_WIN RIGHT_PARENTHESIS  &trans
&kp CAPSLOCK                &kp LEFT_BRACKET          &kp RIGHT_BRACKET       &kp LEFT_BRACE     &kp RIGHT_BRACE          &two_kp EQUAL GREATER_THAN                  &trans      &trans                         &trans     &trans                       &trans                  &trans                            &trans                           &trans
                            &trans                    &trans                  &trans             &trans                                               &trans  &trans  &trans      &trans  &trans  &kp LG(SPACE)             &trans                       &trans                  &trans                            &trans
            >;
        };

        layer_2 {
            bindings = <
&to 0       &kp F11                  &kp F12                  &trans                    &trans               &kp LC(LA(DELETE))                                                      &trans          &trans                  &trans                  &trans                       &trans         &trans
&trans      &kp F6                   &kp F7                   &kp F8                    &kp F9               &kp F10                                                                 &kp HOME        &msc SCRL_DOWN          &msc SCRL_UP            &kp END                      &trans         &trans
&trans      &hm LEFT_GUI F1          &hm LEFT_SHIFT F2        &hm LEFT_ALT F3           &hm LEFT_CONTROL F4  &kp F5                      &trans  &trans      &trans  &trans          &kp LEFT_ARROW  &hm RIGHT_CONTROL DOWN  &hm RIGHT_ALT UP_ARROW  &hm RIGHT_SHIFT RIGHT_ARROW  &kp RIGHT_GUI  &trans
&kp INSERT  &hm LEFT_CONTROL DELETE  &hm LEFT_ALT LS(INSERT)  &hm LEFT_SHIFT LC(LS(C))  &hm LWIN BACKSPACE   &kp ENTER                           &trans      &trans                  &trans          &kp PAGE_DOWN           &kp PAGE_UP             &trans                       &trans         &trans
            &kp LEFT                 &kp UP                   &kp DOWN                  &kp RIGHT                                &trans  &trans  &trans      &trans  &trans  &trans                  &trans                  &trans                  &trans                       &trans
            >;
        };

        layer_3 {
            bindings = <
&to 0   &trans  &trans        &trans        &trans        &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans          &trans  &trans      &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans        &kp NUMBER_0  &kp PERIOD            &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&to 0   &trans  &trans     &trans     &trans          &trans                                                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &kp U      &kp Y           &kp TAB                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &kp D      &kp E           &kp Z            &trans  &trans      &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LC(X)  &kp LC(C)  &kp LS(INSERT)  &trans                   &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans     &trans     &trans                   &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&to 0   &trans  &trans  &trans  &trans  &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans      &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&to 0   &trans  &trans  &trans  &trans  &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans      &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&to 0   &trans  &trans  &trans  &trans  &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans      &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans
            >;
        };

        layer_8 {
            bindings = <
&to 0   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4                                                      &trans           &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &rgb_ug RGB_TOG  &trans                                                            &trans           &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans           &trans                &trans  &trans      &trans  &trans          &trans           &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans           &trans                        &trans      &trans                  &rgb_ug RGB_EFF  &trans  &trans  &trans  &trans  &trans
        &trans        &mo 9         &trans        &trans                         &trans  &trans  &trans      &trans  &trans  &trans                   &trans  &trans  &mo 9   &trans
            >;
        };

        layer_9 {
            bindings = <
&bootloader  &trans          &trans  &trans        &trans        &trans                                                      &trans  &trans  &trans  &trans  &trans  &bootloader
&trans       &trans          &trans  &trans        &trans        &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans       &bt BT_CLR_ALL  &trans  &trans        &trans        &trans          &trans  &trans      &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans          &trans  &bt BT_CLR    &trans        &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
             &trans          &trans  &out OUT_BLE  &out OUT_USB          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans
            >;
        };

        layer_10 {
            bindings = <
&to 0   &trans  &trans  &trans  &trans  &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &to 1   &to 2   &to 3   &to 4   &to 5           &trans  &trans      &trans  &trans          &to 6   &to 7   &to 8   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans
            >;
        };
    };
};
